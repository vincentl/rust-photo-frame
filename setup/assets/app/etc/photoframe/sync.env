# Photo Frame Cloud Sync — /etc/photoframe/sync.env
#
# Uncomment and fill in ONE section below, then enable the sync timer:
#   sudo systemctl enable --now photoframe-sync.timer
#
# For full setup instructions see: docs/advanced.md#cloud-sync

# ── rclone (default, supports 40+ cloud services) ────────────────────────────
#
# Step 1: configure a named remote
#   rclone config
#
# Step 2: set RCLONE_REMOTE to <remote-name>:<path>
#
# RCLONE_REMOTE=gdrive:My Photos/Frame
# RCLONE_REMOTE=dropbox:Photos/Frame
# RCLONE_REMOTE=s3:my-bucket/frame
# RCLONE_REMOTE=onedrive:Frame Photos
# RCLONE_REMOTE=b2:my-bucket/frame
# RCLONE_REMOTE=pcloud:Frame
# RCLONE_REMOTE=pcloud:            (whole account; needs --disable ListR, below)

# Optional: override the default rclone transfer flags. This REPLACES the
# defaults rather than adding to them, so keep the first four flags.
# RCLONE_FLAGS=--checkers=8 --transfers=4 --retries=5 --copy-links
#
# To download only what the frame can show (JPEG/PNG), put the patterns in a
# filter file rather than in RCLONE_FLAGS (the flags are word-split unquoted,
# so quotes and globs here break). /etc/photoframe/rclone-filter.txt:
#   + *.{jpg,jpeg,png}
#   - *
# then:
# RCLONE_FLAGS=--checkers=8 --transfers=4 --retries=5 --copy-links --ignore-case --filter-from=/etc/photoframe/rclone-filter.txt
#
# pCloud from the account root (RCLONE_REMOTE=pcloud:) fails with
# "Invalid request. (1101)" on the Debian rclone; append --disable ListR:
# RCLONE_FLAGS=--checkers=8 --transfers=4 --retries=5 --copy-links --ignore-case --filter-from=/etc/photoframe/rclone-filter.txt --disable ListR

# ── rsync (LAN NAS or local server alternative) ───────────────────────────────
#
# SYNC_TOOL=rsync
# RSYNC_SOURCE=user@nas.local:/photos/frame/
# RSYNC_FLAGS=-av --delete
